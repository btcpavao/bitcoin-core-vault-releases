#!/bin/sh
set -eu
lb config noauto \
  --distribution trixie \
  --architecture amd64 \
  --binary-image iso-hybrid \
  --debian-installer none \
  --debian-installer-gui false \
  --debian-installer-preseedfile '' \
  --apt-recommends false \
  --uefi-secure-boot disable \
  --bootappend-live "boot=live toram components username=vault hostname=core-vault noroot nottyautologin noeject noswap quiet splash loglevel=3 systemd.show_status=false rd.systemd.show_status=false vt.global_cursor_default=0" \
  --bootappend-install '' \
  "$@"
