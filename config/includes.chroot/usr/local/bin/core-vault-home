# VAULT_POWER_KEYBOARD_FLOW_V1: restore only a user-cancelled active modal flow.
class PowerQuestion(QMessageBox):
    def __init__(self, parent, title, message):
        super().__init__(QMessageBox.Question, title, message,
                         QMessageBox.Yes | QMessageBox.No, parent)
        self.setDefaultButton(QMessageBox.No)
        self.setEscapeButton(QMessageBox.No)
        self.cancel_from_active_dialog = False
        self.button(QMessageBox.No).pressed.connect(self.remember_cancel_focus)

    def remember_cancel_focus(self):
        self.cancel_from_active_dialog = self.isActiveWindow()

    def closeEvent(self, event):
        self.remember_cancel_focus()
        super().closeEvent(event)


class Card(QPushButton):
    def __init__(self, tool, icon, enabled, show_help, hide_help):
        super().__init__()
        self.tool = tool
        self.help_text = tool['help']
        self.show_help_callback = show_help
        self.hide_help_callback = hide_help
        self.setObjectName('ToolCard')
        self.setAccessibleName(tool['title'])
        self.setAccessibleDescription(tool['description'] + '. ' + tool['help'])
        self.setCursor(Qt.PointingHandCursor if enabled else Qt.ArrowCursor)
        self.setEnabled(enabled)
        self.hover_timer = QTimer(self)
        self.hover_timer.setSingleShot(True)
        self.hover_timer.setInterval(HOVER_DELAY_MS)
        self.hover_timer.timeout.connect(lambda: self.show_help_callback(self))

        layout = QVBoxLayout(self)
        layout.setContentsMargins(8, 9, 8, 9)
        layout.setSpacing(4)
        self.icon_label = QLabel()
        self.icon_label.setAlignment(Qt.AlignCenter)
        self.icon_label.setFixedHeight(44)
        self.icon_label.setPixmap(optical_icon(icon))
        self.title_label = QLabel(tool['title'])
        self.title_label.setObjectName('CardTitle')
        self.title_label.setWordWrap(True)
        self.description_label = QLabel(tool['description'])
        self.description_label.setObjectName('CardDescription')
        self.description_label.setWordWrap(True)
        self.description_label.setMinimumHeight(28)
        layout.addStretch(1)
        for label in (self.icon_label, self.title_label, self.description_label):
            label.setAlignment(Qt.AlignCenter)
            label.setAttribute(Qt.WA_TransparentForMouseEvents)
            layout.addWidget(label)
        layout.addStretch(1)

    def enterEvent(self, event):
        self.hover_timer.start()
        super().enterEvent(event)

    def leaveEvent(self, event):
        self.hover_timer.stop()
        self.hide_help_callback(self)
        super().leaveEvent(event)

    def mousePressEvent(self, event):
        self.hover_timer.stop()
        self.hide_help_callback(self)
        super().mousePressEvent(event)


class HintButton(QPushButton):
    def __init__(self, text, help_text, show_help, hide_help):
        super().__init__(text)
        self.setCursor(Qt.PointingHandCursor)
        self.help_text = help_text
        self.show_help_callback = show_help
        self.hide_help_callback = hide_help
        self.hover_timer = QTimer(self)
        self.hover_timer.setSingleShot(True)
        self.hover_timer.setInterval(HOVER_DELAY_MS)
        self.hover_timer.timeout.connect(lambda: self.show_help_callback(self))

    def enterEvent(self, event):
        self.hover_timer.start()
        super().enterEvent(event)

    def leaveEvent(self, event):
        self.hover_timer.stop()
        self.hide_help_callback(self)
        super().leaveEvent(event)

    def mousePressEvent(self, event):
        self.hover_timer.stop()
        self.hide_help_callback(self)
        super().mousePressEvent(event)


class RamNoticeWorker(QThread):
    received = Signal(str)

    def run(self):
        try:
            result = session_files()
        except Exception:
            result = 'unknown'  # Never log wallet paths or treat a failure as empty.
        self.received.emit(result)


class VaultHome(QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowTitle(TITLE)
        self.setWindowIcon(QIcon(str(ASSETS / 'bitcoin-ui.png')))
        self.setWindowFlags(Qt.Window | Qt.FramelessWindowHint |
                            Qt.WindowStaysOnBottomHint)
        self.setAttribute(Qt.WA_X11NetWmWindowTypeDesktop, True)
        self.setAttribute(Qt.WA_ShowWithoutActivating, True)
        self.setObjectName('VaultSurface')
        self.setStyleSheet(STYLE)
        self.preview_windows = []
        self.children_started = []
        self.cards = []
        self._layout_key = None
        self._test_size = None
        self.notice_job = None
        self.notice_position_timer = QTimer(self)
        self.notice_position_timer.setSingleShot(True)
        self.notice_position_timer.timeout.connect(self.position_ram_notice)
        self.screen_ref = QApplication.primaryScreen()
        if self.screen_ref is None:
            raise RuntimeError('No graphical screen is available')
        self.build_ui()
        self.build_ram_notice()
        self.build_hover_popup()
        self.screen_ref.geometryChanged.connect(self.fit_screen)
        self.screen_ref.availableGeometryChanged.connect(self.fit_screen)
        self.fit_screen()
        self.reaper = QTimer(self)
        self.reaper.timeout.connect(self.reap)
        self.reaper.start(1000)

        self._background_action = None
        QApplication.instance().installEventFilter(self)
        self.notice_timer = QTimer(self)
        self.notice_timer.setInterval(1500)
        self.notice_timer.timeout.connect(self.poll_ram_notice)
        QApplication.instance().aboutToQuit.connect(self.stop_ram_notice)
        if not (args.preview or args.self_test):
            self.notice_timer.start()
            QTimer.singleShot(0, lambda: self.poll_ram_notice()
                              if self.notice_timer.isActive() else None)

    def build_ui(self):
        self.outer = QVBoxLayout(self)
        self.outer.setSpacing(0)
        self.scroll = QScrollArea()
        self.scroll.setObjectName('CenterScroll')
        self.scroll.setWidgetResizable(True)
        self.scroll.setFrameShape(QFrame.NoFrame)
        self.scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        self.scroll.setVerticalScrollBarPolicy(Qt.ScrollBarAsNeeded)
        self.scroll.viewport().setAutoFillBackground(False)
        self.body = QWidget()
        self.body.setObjectName('CenterBody')
        self.body_layout = QVBoxLayout(self.body)
        self.body_layout.setContentsMargins(0, 8, 0, 8)
        self.body_layout.setSpacing(0)
        self.body_layout.addStretch(1)

        self.header = QWidget()
        self.header.setObjectName('Header')
        header = QVBoxLayout(self.header)
        header.setContentsMargins(0, 0, 0, 0)
        header.setSpacing(8)
        header.addWidget(image_label(ASSETS / 'bitcoin-ui.png', (48, 48)),
                         alignment=Qt.AlignCenter)
        title = QLabel(TITLE)
        title.setObjectName('MainTitle')
        title.setAlignment(Qt.AlignCenter)
        header.addWidget(title)
        sub = QLabel('Private session: wallets and working files stay in RAM until shutdown.\n'
                     'Please back up all necessary files and wallets to external media before shutdown or restart, '
                     'as all data kept only in RAM will be lost.')
        sub.setObjectName('MainSubtitle')
        sub.setAlignment(Qt.AlignCenter)
        sub.setWordWrap(True)
        header.addWidget(sub)
        self.body_layout.addWidget(self.header)
        self.body_layout.addSpacing(16)

        self.grid_wrap = QWidget()
        self.grid_wrap.setObjectName('CardGrid')
        self.grid = QGridLayout(self.grid_wrap)
        self.grid.setContentsMargins(0, 0, 0, 0)
        self.grid.setHorizontalSpacing(14)
        self.grid.setVerticalSpacing(14)

        for tool in TOOLS:
            icon = icon_for(tool['icons'], tool['fallback'])
            if tool['title'] == 'Bitcoin Core':
                custom = QIcon(str(ASSETS / 'bitcoin-ui.png'))
                if not custom.isNull():
                    icon = custom
            # Vault-owned transparent glyphs avoid the dark raster tiles in
            # some icon themes (notably document-decrypt and printer).
            if tool['title'] in ('Decrypt Backup', 'Print & Labels'):
                filename = ('decrypt-backup.png' if tool['title'] == 'Decrypt Backup'
                            else 'print-labels.png')
                custom = QIcon(str(ASSETS / 'icons' / filename))
                if not custom.isNull():
                    icon = custom
            command = tool['command']
            if command is None:
                enabled = True
            elif args.preview or args.self_test:
                enabled = True
            else:
                enabled = (Path(command[0]).exists() if command[0].startswith('/')
                           else shutil.which(command[0]) is not None)
            card = Card(tool, icon, enabled, self.show_card_help, self.hide_card_help)
            card.clicked.connect(lambda checked=False, c=command, t=tool['title']:
                                 self.activate_tool(t, c))
            self.cards.append(card)

        self.body_layout.addWidget(self.grid_wrap, alignment=Qt.AlignCenter)
        self.body_layout.addStretch(1)
        self.body.installEventFilter(self)
        self.scroll.setWidget(self.body)
        self.outer.addWidget(self.scroll, 1)

        self.footer = QWidget()
        self.footer.setObjectName('Footer')
        self.footer.setFixedHeight(60)
        footer = QHBoxLayout(self.footer)
        footer.setContentsMargins(0, 0, 0, 0)
        footer.setSpacing(0)
        # VAULT_POWER_CONTROLS_V1
        # Equal-width left/right footer zones keep Powered by Debian GNU/Linux centered.
        left = QWidget()
        left.setObjectName('FooterSpacer')
        left.setFixedWidth(256)
        footer.addWidget(left)
        self.credit_box = QWidget()
        self.credit_box.setObjectName('CreditBox')
        credit = QVBoxLayout(self.credit_box)
        credit.setContentsMargins(0, 0, 0, 0)
        credit.setSpacing(2)
        self.debian_logo = image_label(ASSETS / 'debian-ui.png', (20, 26))
        credit.addWidget(self.debian_logo, alignment=Qt.AlignCenter)
        caption = QLabel('Powered by Debian GNU/Linux')
        caption.setObjectName('Credit')
        caption.setAlignment(Qt.AlignCenter)
        credit.addWidget(caption)
        footer.addWidget(self.credit_box, 1)

        power_box = QWidget()
        power_box.setObjectName('PowerControls')
        power_box.setFixedWidth(256)
        power = QHBoxLayout(power_box)
        power.setContentsMargins(0, 0, 0, 0)
        power.setSpacing(8)

        restart_help = (
            'Confirm saved files and RAM data loss, then start a five-minute restart countdown. '
            'All wallets and working files in RAM will disappear.'
        )
        # VAULT_POWER_ICON_BUTTONS_V1: retain the existing confirmation/actions.
        power.addStretch(1)
        self.restart_button = HintButton(
            '', restart_help, self.show_card_help, self.hide_card_help)
        self.restart_button.setObjectName('Restart')
        self.restart_button.setAccessibleName('Restart')
        self.restart_button.setAccessibleDescription(restart_help)
        self.restart_button.setIcon(power_icon(True))
        self.restart_button.setIconSize(QSize(44, 44))
        self.restart_button.setFixedSize(48, 48)
        self.restart_button.clicked.connect(self.restart)
        power.addWidget(self.restart_button)

        shutdown_help = (
            'Confirm saved files and RAM data loss, then start a five-minute shutdown countdown. '
            'All wallets and working files in RAM will disappear.')
        self.shutdown_button = HintButton(
            '', shutdown_help, self.show_card_help, self.hide_card_help)
        self.shutdown_button.setObjectName('Shutdown')
        self.shutdown_button.setAccessibleName('Finish & Shut Down')
        self.shutdown_button.setAccessibleDescription(shutdown_help)
        self.shutdown_button.setIcon(power_icon(False))
        self.shutdown_button.setIconSize(QSize(44, 44))
        self.shutdown_button.setFixedSize(48, 48)
        self.shutdown_button.clicked.connect(self.shutdown)
        power.addWidget(self.shutdown_button)
        footer.addWidget(power_box, 0, Qt.AlignVCenter)
        self.outer.addWidget(self.footer)

    def build_ram_notice(self):
        # Reserve room even while hidden, so showing the reminder cannot move
        # the launchers and the 800x600 layout cannot cover the Debian credit.
        self.ram_notice_slot = QWidget()
        self.ram_notice_slot.setStyleSheet('background:transparent;')
        self.ram_notice_slot.setFixedHeight(88)
        self.body_layout.insertWidget(self.body_layout.indexOf(self.grid_wrap) + 1,
                                      self.ram_notice_slot)
        self.ram_notice_state = 'checking'
        self.ram_notice = QLabel(NOTICE, self)
        self.ram_notice.setObjectName('PrivateRamReminder')
        self.ram_notice.setWordWrap(True)
        self.ram_notice.setAlignment(Qt.AlignCenter)
        self.ram_notice.setTextFormat(Qt.PlainText)
        self.ram_notice.setAccessibleName('Temporary RAM files reminder')
        self.ram_notice.setAttribute(Qt.WA_TransparentForMouseEvents, True)
        self.ram_notice.setStyleSheet('background:transparent;color:#f2f2f2;font-style:italic;font-size:14px;')
        self.ram_notice.hide()

    def poll_ram_notice(self):
        if self.notice_job is not None:
            return
        job = RamNoticeWorker(self)
        self.notice_job = job
        job.received.connect(self.update_ram_notice)
        job.finished.connect(self.notice_finished)
        job.start()

    @Slot(str)
    def update_ram_notice(self, result):
        self.ram_notice_state = result
        self.ram_notice.setText(NOTICE if result == 'files' else UNCERTAIN)
        self.ram_notice.setVisible(result != 'empty')
        self.queue_ram_notice_position()

    @Slot()
    def notice_finished(self):
        job = self.notice_job
        self.notice_job = None
        if job is not None:
            job.deleteLater()

    @Slot()
    def stop_ram_notice(self):
        self.notice_timer.stop()
        if self.notice_job is not None:
            self.notice_job.wait()  # Metadata scan has its own time/entry bounds.

    def queue_ram_notice_position(self):
        timer = getattr(self, 'notice_position_timer', None)
        if timer is not None and not timer.isActive():
            timer.start(0)

    def position_ram_notice(self):
        if not hasattr(self, 'ram_notice') or not self.cards:
            return
        self.body_layout.activate(); self.grid.activate()
        self.footer.layout().activate(); self.credit_box.layout().activate()
        width = min(620, max(300, self.width() - 60))
        size = 14 if getattr(self, '_home_density', 0) == 0 else 12
        style = f'background:transparent;color:#f2f2f2;font-style:italic;font-size:{size}px;'
        if self.ram_notice.styleSheet() != style:
            self.ram_notice.setStyleSheet(style)
        self.ram_notice.ensurePolished()
        self.ram_notice.setFixedWidth(width)
        height = max(self.ram_notice.minimumSizeHint().height(), self.ram_notice.heightForWidth(width))
        self.ram_notice.setFixedHeight(height)
        bottoms = [card.mapTo(self, QPoint(0, card.height())).y()
                   for card in self.cards if not card.isHidden()]
        if not bottoms:
            return
        top = max(bottoms)
        bottom = self.debian_logo.mapTo(self, QPoint()).y()
        self.ram_notice.move((self.width() - width) // 2, round((top + bottom - height) / 2))
        if not self.ram_notice.isHidden():
            self.ram_notice.raise_()
        geometry = (self.ram_notice_state, not self.ram_notice.isHidden(),
                    self.ram_notice.x(), self.ram_notice.y(), width, height, top, bottom)
        if getattr(self, '_last_notice_geometry', None) != geometry:
            self._last_notice_geometry = geometry
            self.write_geometry()

    def build_hover_popup(self):
        self.hover_popup = QFrame(self)
        self.hover_popup.setObjectName('HoverPopup')
        self.hover_popup.setAttribute(Qt.WA_TransparentForMouseEvents, True)
        layout = QVBoxLayout(self.hover_popup)
        layout.setContentsMargins(12, 10, 12, 10)
        self.hover_text = QLabel()
        self.hover_text.setObjectName('HoverText')
        self.hover_text.setWordWrap(True)
        self.hover_text.setFixedWidth(310)
        layout.addWidget(self.hover_text)
        self.hover_popup.hide()
        self.hover_card = None

    def show_card_help(self, card):
        if not card.underMouse() and not args.self_test:
            return
        self.hover_card = card
        self.hover_text.setText(card.help_text)
        self.hover_popup.adjustSize()
        p = card.mapTo(self, QPoint(0, 0))
        x = p.x() + (card.width() - self.hover_popup.width()) // 2
        y = p.y() - self.hover_popup.height() - 10
        x = max(10, min(x, self.width() - self.hover_popup.width() - 10))
        if y < 10:
            y = p.y() + card.height() + 10
        y = max(10, min(y, self.height() - self.hover_popup.height() - 10))
        self.hover_popup.move(x, y)
        self.hover_popup.show()
        self.hover_popup.raise_()

    def hide_card_help(self, card=None):
        if card is None or card is self.hover_card:
            self.hover_popup.hide()
            self.hover_card = None

    def fit_screen(self, *_):
        if self._test_size:
            width, height = self._test_size
            geometry = QRect(0, 0, width, height)
            panel = 40
        else:
            geometry = self.screen_ref.geometry()
            available = self.screen_ref.availableGeometry()
            panel = max(0, geometry.bottom() - available.bottom())
            panel = min(panel, geometry.height() // 3)
        if self.geometry() != geometry:
            self.setGeometry(geometry)
        self.outer.setContentsMargins(24, 16, 24, panel + 12)
        self.hide_card_help()
        QTimer.singleShot(0, self.layout_cards)

    def apply_home_density(self, level):
        # Compact only as much as the available height requires.
        if getattr(self, '_home_density', None) == level:
            return
        self._home_density = level
        logo_size, title_size, subtitle_size, icon_size, card_title, card_detail, margin, spacing, gap = (
            (48, 28, 14, 42, 14, 11, 9, 4, 16),
            (40, 26, 13, 34, 14, 11, 6, 3, 12),
            (28, 22, 12, 28, 12, 10, 4, 2, 8),
        )[level]
        logo = self.header.layout().itemAt(0).widget()
        if not hasattr(self, '_home_logo'):
            self._home_logo = QPixmap(logo.pixmap())
        logo.setFixedSize(logo_size, logo_size)
        logo.setPixmap(self._home_logo.scaled(logo_size, logo_size,
                                             Qt.KeepAspectRatio, Qt.SmoothTransformation))
        for name, size in (('MainTitle', title_size), ('MainSubtitle', subtitle_size)):
            label = self.header.findChild(QLabel, name)
            label.setStyleSheet('font-size: %dpx;' % size)
        self.header.layout().setSpacing(8 if level == 0 else 4)
        header_index = self.body_layout.indexOf(self.header)
        self.body_layout.itemAt(header_index + 1).spacerItem().changeSize(0, gap)
        for card in getattr(self, 'all_home_cards', self.cards):
            layout = card.layout()
            layout.setContentsMargins(8 if level == 0 else 6, margin,
                                      8 if level == 0 else 6, margin)
            layout.setSpacing(spacing)
            card.title_label.setStyleSheet('font-size: %dpx;' % card_title)
            card.description_label.setStyleSheet('font-size: %dpx;' % card_detail)
            card.title_label.ensurePolished()
            card.description_label.ensurePolished()
            if not hasattr(card, '_home_icon'):
                card._home_icon = QPixmap(card.icon_label.pixmap())
            pixmap = card._home_icon.scaled(icon_size * 2, icon_size * 2,
                                           Qt.KeepAspectRatio, Qt.SmoothTransformation)
            pixmap.setDevicePixelRatio(2)
            card.icon_label.setPixmap(pixmap)
            card.icon_label.setFixedHeight(icon_size + (2 if level == 0 else 0))
        if hasattr(self, 'activity_row'):
            activity_index = self.body_layout.indexOf(self.activity_row)
            self.body_layout.itemAt(activity_index - 1).spacerItem().changeSize(
                0, 24 if level == 0 else 8)
            self.activity_row.layout().setSpacing(8 if level == 0 else 4)
            self.activity_text.setStyleSheet(
                'font-style:italic; font-size:%dpx;' % (14 if level == 0 else 12))
        self.body_layout.invalidate()

    def layout_cards(self):
        viewport = self.scroll.viewport()
        width = max(360, min(1120, viewport.width() - 8))
        columns = 5 if width >= 680 else 2
        card_width = (width - (columns - 1) * 14) // columns
        rows = math.ceil(len(self.cards) / columns)
        feedback = tuple((getattr(self, name).text(), getattr(self, name).isHidden())
                         for name in ('activity_text', 'status') if hasattr(self, name))
        key = (viewport.width(), viewport.height(), len(self.cards), feedback)
        if key == self._layout_key:
            self.queue_ram_notice_position()
            return
        self._layout_key = key
        self.hide_card_help()
        for level in range(3):
            self.apply_home_density(level)
            vertical_margin = 8 if level == 0 and viewport.height() >= 500 else 2
            vertical_gap = (14, 10, 8)[level]
            self.body_layout.setContentsMargins(0, vertical_margin, 0, vertical_margin)
            self.grid.setVerticalSpacing(vertical_gap)
            self.header.layout().invalidate()
            header_height = self.header.heightForWidth(viewport.width())
            if header_height < 0:
                header_height = self.header.sizeHint().height()
            self.header.setFixedHeight(header_height)
            extra = 0
            for index in range(self.body_layout.count()):
                item = self.body_layout.itemAt(index)
                widget = item.widget()
                if widget in (self.header, self.grid_wrap):
                    continue
                if widget is not None:
                    if widget.isHidden() and not widget.sizePolicy().retainSizeWhenHidden():
                        continue
                    height = widget.heightForWidth(viewport.width())
                    extra += max(item.minimumSize().height(),
                                 height if height >= 0 else item.sizeHint().height())
                elif item.spacerItem():
                    extra += item.spacerItem().sizeHint().height()
            minimum_card_height = 0
            for card in self.cards:
                margins = card.layout().contentsMargins()
                text_width = card_width - margins.left() - margins.right()
                card.title_label.setMinimumHeight(0)
                card.description_label.setMinimumHeight(0)
                title_height = card.title_label.heightForWidth(text_width)
                detail_height = card.description_label.heightForWidth(text_width)
                card.title_label.setMinimumHeight(max(title_height, 0))
                card.description_label.setMinimumHeight(max(detail_height, 0))
                card.layout().invalidate()
                minimum_card_height = max(minimum_card_height,
                                          card.layout().minimumSize().height())
            available = (viewport.height() - header_height - extra -
                         2 * vertical_margin - (rows - 1) * vertical_gap)
            card_height = min(144, available // max(rows, 1))
            if card_height >= minimum_card_height:
                break
        # Keep readable content reachable on unusually small displays. Supported
        # laptop sizes fit before this floor; never hide an overflowing scroll.
        card_height = max(minimum_card_height, card_height)
        while self.grid.count():
            self.grid.takeAt(0)
        for index, card in enumerate(self.cards):
            card.setFixedSize(card_width, card_height)
            row = index // columns
            row_count = min(columns, len(self.cards) - row * columns)
            offset = columns - row_count
            self.grid.addWidget(card, row, 2 * (index % columns) + offset, 1, 2)
        self.grid_wrap.setFixedSize(columns * card_width + (columns - 1) * 14,
                                    rows * card_height + (rows - 1) * vertical_gap)
        self.body.setMinimumHeight(header_height + extra +
                                   self.grid_wrap.height() + 2 * vertical_margin)
        self.body_layout.invalidate()
        QTimer.singleShot(0, self.write_geometry)
        self.queue_ram_notice_position()

    def resizeEvent(self, event):
        super().resizeEvent(event)
        self.hide_card_help()
        QTimer.singleShot(0, self.layout_cards)

    def closeEvent(self, event):
        event.ignore()

    def write_geometry(self):
        if args.self_test:
            return
        runtime = os.environ.get('XDG_RUNTIME_DIR')
        if not runtime:
            return
        def rect(r):
            return [r.x(), r.y(), r.width(), r.height()]
        obj = {'version': VERSION, 'pid': os.getpid(), 'window_id': hex(int(self.winId())),
               'desktop_geometry': rect(self.geometry()),
               'screen_geometry': rect(self.screen_ref.geometry()),
               'available_geometry': rect(self.screen_ref.availableGeometry()),
               'card_sizes': [[c.width(), c.height()] for c in self.cards],
               'card_titles': [c.tool['title'] for c in self.cards]}
        obj['window_behavior'] = 'background-click-v1.2'
        if hasattr(self, 'ram_notice'):
            # Only display state and rectangles; never filenames or file counts.
            obj['private_ram_notice'] = dict(state=self.ram_notice_state,
                visible=not self.ram_notice.isHidden(), rect=rect(self.ram_notice.geometry()),
                debian_logo_top=self.debian_logo.mapTo(self, QPoint()).y())
        obj['card_rects'] = [
            [c.mapTo(self, QPoint(0, 0)).x(), c.mapTo(self, QPoint(0, 0)).y(),
             c.width(), c.height()] for c in self.cards]
        try:
            (Path(runtime) / 'core-vault-desktop-geometry.json').write_text(
                json.dumps(obj, indent=2) + '\n')
        except OSError as exc:
            print(f'Geometry report unavailable: {exc}', file=sys.stderr)

    def activate_tool(self, title, command):
        self.hide_card_help()
        if args.preview or args.self_test:
            dialog = QWidget(None, Qt.Window)
            dialog.setWindowTitle('Preview — ' + title)
            dialog.resize(500, 300)
            layout = QVBoxLayout(dialog)
            label = QLabel('Desktop preview only.\nNo wallet, archive, printer or system setting is opened.\n\n'
                           'Move, minimize and restore this window using the taskbar.')
            label.setAlignment(Qt.AlignCenter)
            layout.addWidget(label)
            close = QPushButton('Close preview window')
            close.clicked.connect(dialog.close)
            layout.addWidget(close)
            self.preview_windows.append(dialog)
            dialog.show()
            dialog.raise_()
            dialog.activateWindow()
            return
        if command is None:
            PRIVATE.mkdir(parents=True, exist_ok=True)
            command = ['thunar', str(PRIVATE)]
        try:
            self.children_started.append(subprocess.Popen(command, start_new_session=True))
        except OSError as exc:
            QMessageBox.warning(self, 'Cannot open ' + title, str(exc))

    def reap(self):
        self.children_started = [p for p in self.children_started if p.poll() is None]


    def power_question(self, title, message, button):
        home_was_active = self.isActiveWindow()
        dialog = PowerQuestion(self, title, message)
        answer = dialog.exec()
        if (answer == QMessageBox.No and home_was_active
                and dialog.cancel_from_active_dialog):
            # This follows a deliberate No/Esc in the active Home-owned dialog.
            # No startup timer, background click or foreign-window close calls it.
            button.setFocus(Qt.OtherFocusReason)
            self.activateWindow()
        dialog.deleteLater()
        return answer

    def restart(self):
        self.hide_card_help()
        if args.preview or args.self_test:
            QMessageBox.information(self, 'Desktop preview',
                                    'Preview mode does not restart the computer.')
            return
        self.children_started.append(subprocess.Popen(
            ['/usr/local/bin/core-vault-finish', '--restart'], start_new_session=True))

    def shutdown(self):
        self.hide_card_help()
        if args.preview or args.self_test:
            QMessageBox.information(self, 'Desktop preview',
                                    'Preview mode does not shut down the computer.')
            return
        self.children_started.append(subprocess.Popen(
            ['/usr/local/bin/core-vault-finish'], start_new_session=True))

    # VAULT_BACKGROUND_CLICK_V12
    def _home_control_at(self, widget, position=None):
        # Disabled cards must also remain controls, even when Qt routes their
        # mouse events to a parent. Check their rectangles as well as ancestry.
        if position is not None:
            for card in self.cards:
                if card.isVisible() and QRect(card.mapTo(self, QPoint(0, 0)),
                                               card.size()).contains(position):
                    return True
        current = widget if isinstance(widget, QWidget) else None
        while current is not None and current is not self:
            if isinstance(current, (QAbstractButton, QScrollBar)):
                return True
            current = current.parentWidget()
        return False

    def _belongs_to_home(self, widget):
        # In preview, other application-like windows live in the same process.
        # Never treat a click inside those top-level windows as a desktop click.
        return isinstance(widget, QWidget) and widget.window() is self

    def show_home_from_background_click(self):
        self.hide_card_help()
        if args.self_test:
            return
        if self._background_action is not None and self._background_action.poll() is None:
            return
        helper = Path(__file__).resolve().with_name('core-vault-show-home')
        try:
            self._background_action = subprocess.Popen(
                [sys.executable, str(helper), '--home-window', str(int(self.winId()))],
                stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                start_new_session=True,
            )
            self.children_started.append(self._background_action)
        except OSError as exc:
            print('Vault background click:', exc, file=sys.stderr)

    def eventFilter(self, watched, event):
        # Match the Node's centering after taskbar/work-area and layout changes.
        boundaries = ('body', 'grid_wrap', 'footer', 'credit_box', 'debian_logo')
        if (event.type() in (QEvent.Move, QEvent.Resize, QEvent.Show, QEvent.Hide, QEvent.LayoutRequest)
                and any(watched is getattr(self, name, None) for name in boundaries)):
            self.queue_ram_notice_position()
        if watched is self.body and event.type() == QEvent.LayoutRequest:
            QTimer.singleShot(0, self.layout_cards)
        if (event.type() == QEvent.MouseButtonPress
                and event.button() == Qt.LeftButton
                and self._belongs_to_home(watched)):
            position = self.mapFromGlobal(event.globalPosition().toPoint())
            if not self._home_control_at(watched, position):
                self.show_home_from_background_click()
                # Consume this event so propagation through the scroll area,
                # body and desktop cannot trigger the action several times.
                return True
        return super().eventFilter(watched, event)



def self_test(app, window):
    if len(window.cards) != 10:
        raise RuntimeError(f'Expected 10 cards, got {len(window.cards)}')
    expected = [t['title'] for t in TOOLS]
    actual = [c.tool['title'] for c in window.cards]
    if actual != expected:
        raise RuntimeError(f'Unexpected card order: {actual}')
    if any(not c.help_text for c in window.cards):
        raise RuntimeError('One or more custody hover descriptions are empty')

    for width, height in ((800, 600), (1024, 768), (1280, 800), (1920, 1080)):
        window._test_size = (width, height)
        window._layout_key = None
        window.fit_screen()
        window.show()
        for _ in range(8):
            app.processEvents()
            window.layout_cards()
        sizes = {(c.width(), c.height()) for c in window.cards}

        if width >= 800 and window.scroll.verticalScrollBar().isVisible():
            raise RuntimeError(
                f'Unexpected vertical scrollbar at {width}x{height}'
            )

        if len(sizes) != 1:
            raise RuntimeError(f'Unequal cards at {width}x{height}: {sizes}')
        center = window.grid_wrap.mapTo(window, window.grid_wrap.rect().center())
        if abs(center.x() - window.rect().center().x()) > 2:
            raise RuntimeError(f'Grid not centered at {width}x{height}: {center.x()}')
        footer_center = window.credit_box.mapTo(window, window.credit_box.rect().center())
        if abs(footer_center.x() - window.rect().center().x()) > 2:
            raise RuntimeError('Footer not centered')
        if window.footer.mapTo(window, window.footer.rect().bottomLeft()).y() >= height - 40:
            raise RuntimeError('Footer overlaps taskbar')
        card = window.cards[0]
        capture = card.grab().toImage()
        pos = card.icon_label.mapTo(card, card.icon_label.rect().topLeft())
        colour = capture.pixelColor(pos.x() + 2, pos.y() + 10)
        if colour.red() < 12 or colour.green() < 12 or colour.blue() < 12:
            raise RuntimeError(f'Black icon strip at {width}x{height}: {colour.name()}')
        window.show_card_help(card)
        app.processEvents()
        if not window.hover_popup.isVisible() or 'Create and encrypt wallets' not in window.hover_text.text():
            raise RuntimeError('Custom custody hover popup failed')
        window.hide_card_help(card)
        print(f'PASS {width}x{height}: 10 centered cards, custom hover help, visible footer')
    print('VAULT HOME SUITE QT SELF-TEST PASSED')


def main():
    app = QApplication(['core-vault-home'])
    app.setApplicationName('core-vault-home')
    app.setStyle('Fusion')
    app.setFont(QFont('DejaVu Sans', 10))
    app.setQuitOnLastWindowClosed(False)
    QIcon.setThemeName('Adwaita')
    QIcon.setFallbackThemeName('hicolor')
    lock = None
    if not args.self_test:
        runtime = Path(os.environ.get('XDG_RUNTIME_DIR', ''))
        if not runtime.is_absolute() or not runtime.is_dir() or runtime.stat().st_uid != os.getuid():
            raise RuntimeError('Missing owned XDG_RUNTIME_DIR')
        lock = (runtime / 'core-vault-home-ui.lock').open('a')
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 0
    window = VaultHome()
    if args.self_test:
        self_test(app, window)
        return 0
    window.show()
    QTimer.singleShot(200, window.fit_screen)
    QTimer.singleShot(750, window.write_geometry)
    return app.exec()


if __name__ == '__main__':
    sys.exit(main())
