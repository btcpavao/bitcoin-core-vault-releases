[Unit]
Description=Bitcoin Core Vault volatile system temporary files in /var/tmp
DefaultDependencies=no
After=local-fs-pre.target
Before=local-fs.target umount.target systemd-tmpfiles-setup.service core-vault-prepare.service core-vault-workspace-check.service lightdm.service
Conflicts=umount.target

[Mount]
What=tmpfs
Where=/var/tmp
Type=tmpfs
Options=noswap,nosuid,nodev,noexec,mode=1777,size=5%%

[Install]
WantedBy=local-fs.target
