#!/bin/sh
set -eu

# live-build runs binary hooks from binary/, retaining the source hook path.
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
source_root=$(CDPATH= cd -- "$script_dir/../../.." && pwd)
if [ -f binary/live/filesystem.squashfs ]; then
    binary_root=binary
else
    binary_root=.
fi

exec python3 "$source_root/tools/local-build/write-live-boot-menu.py" \
    --binary-root "$binary_root" \
    --models "$source_root/config/includes.chroot/usr/share/core-vault/t2-models.json"
