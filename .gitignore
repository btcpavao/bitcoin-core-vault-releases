# live-build generated state
.build/
binary/
chroot/
cache/

# Build workspaces / VM state / backups
/build-assets/*
!/build-assets/core-vault-calamares-v1/
/build-assets/core-vault-calamares-v1/*
!/build-assets/core-vault-calamares-v1/package.json
build-backups/
build-vm/
.polish-backups/
.visual-backups/

# Release artifacts
release/
/candidate-artifacts/
*.iso
*.iso.sha256

# live-build generated manifests
binary.modified_timestamps
chroot.files
chroot.packages.install
chroot.packages.live
live-image-*.contents
live-image-*.files
live-image-*.packages

# Logs and temporary downloads
*.log
wget-log*
*.tmp

# Python generated files
__pycache__/
*.py[cod]

# Editor / OS noise
*~
.DS_Store

# Old local/reference artifacts
/bitcoin-logo.webp
/debian-logo.webp
/bitcoin-qt-ldd.txt

# Generated by lb config
/config/binary
/config/bootstrap
/config/chroot
/config/common
/config/source

# Historical local source snapshots and generated package outputs
/tools/core-vault/backups/
/tools/core-vault/backup-src/*.deb

# Verified upstream software is fetched from the pinned build manifest.
/config/includes.chroot/opt/keepassxc/
/config/includes.chroot/usr/share/icons/hicolor/256x256/apps/keepassxc.png
