# live-build generated state
.build/
binary/
chroot/
cache/

# Build workspaces / VM state / backups
/build-assets/*
!/build-assets/core-vault-calamares-v1/
/build-assets/core-vault-calamares-v1/*
!/build-assets/core-vault-calamares-v1/package.json
build-backups/
build-vm/
.polish-backups/
.visual-backups/

# Release artifacts
release/
/candidate-artifacts/
*.iso
*.iso.sha256

# live-build generated manifests
binary.modified_timestamps
chroot.files
chroot.packages.install
chroot.packages.live
live-image-*.contents
live-image-*.files
live-image-*.packages

# Logs and temporary downloads
*.log
wget-log*
*.tmp

# Python generated files
__pycache__/
*.py[cod]

# Editor / OS noise
*~
.DS_Store

# Old local/reference artifacts
/bitcoin-logo.webp
/debian-logo.webp
/bitcoin-qt-ldd.txt

# Generated by lb config
/config/binary
/config/bootstrap
/config/chroot
/config/common
/config/source

# Historical local source snapshots and generated package outputs
/tools/core-vault/backups/
/tools/core-vault/backup-src/*.deb

# Verified upstream software is fetched from the pinned build manifest.
/config/includes.chroot/opt/keepassxc/
/config/includes.chroot/usr/share/icons/hicolor/256x256/apps/keepassxc.png

# Generated release evidence and verified upstream T2 inputs.
/output/
/config/packages.chroot/linux-image-6.18.64-1-t2-trixie_6.18.64-1_amd64.deb
/config/packages.chroot/firmware-intel-graphics_20250410-2_all.deb
/config/packages.chroot/firmware-amd-graphics_20250410-2_all.deb

# Pinned public signed repository metadata required by T2 preparation.
!/build-assets/core-vault-t2-v1/
/build-assets/core-vault-t2-v1/*
!/build-assets/core-vault-t2-v1/KEY.gpg
!/build-assets/core-vault-t2-v1/maintainer-keyring.gpg
!/build-assets/core-vault-t2-v1/trixie-InRelease
!/build-assets/core-vault-t2-v1/trixie-Packages.gz
!/build-assets/core-vault-t2-v1/debian-trixie-InRelease
!/build-assets/core-vault-t2-v1/debian-trixie-firmware-Packages.xz
!/build-assets/core-vault-t2-v1/upstream-sha256-trixie
