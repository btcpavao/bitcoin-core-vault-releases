<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Bitcoin Core Vault</vendor>
  <action id="org.bitcoin-core-vault.device-settings">
    <description>Save local device preferences on installed Vault</description>
    <message>Please use Settings in the active local Vault session.</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>no</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/core-vault-device-settings</annotate>
  </action>
</policyconfig>
