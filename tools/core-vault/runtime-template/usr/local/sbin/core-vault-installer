#!/usr/bin/python3

import json
import os
import pathlib
import pwd
import re
import shutil
import signal
import stat
import subprocess
import sys


def print_log_tail(log_path, lines=120):
    try:
        content = log_path.read_text(
            encoding="utf-8",
            errors="replace"
        ).splitlines()

        print(
            "\n=== CALAMARES INSTALLER LOG — LAST LINES ===",
            file=sys.stderr
        )

        for line in content[-lines:]:
            print(line, file=sys.stderr)

        print(
            "=== END CALAMARES LOG ===\n",
            file=sys.stderr
        )

    except Exception as exc:
        print(
            f"Could not read Calamares log: {exc}",
            file=sys.stderr
        )



def reviewed_calamares_version():
    """Read the image's exact package pin without trusting user-writable data."""
    path = pathlib.Path("/etc/core-vault/installer-payload.json")
    limit = 1048576

    # The fixed path and all parent directories must remain controlled by root.
    for directory in path.parents:
        info = directory.lstat()
        if (
            not stat.S_ISDIR(info.st_mode)
            or info.st_uid != 0
            or info.st_mode & 0o022
        ):
            raise RuntimeError("Unsafe installer payload manifest directory.")

    descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    with os.fdopen(descriptor, "rb") as source:
        info = os.fstat(source.fileno())
        if (
            not stat.S_ISREG(info.st_mode)
            or info.st_uid != 0
            or info.st_mode & 0o022
            or not 0 < info.st_size <= limit
        ):
            raise RuntimeError(
                "Installer payload manifest must be a bounded, root-owned "
                "regular file without group or other write permission."
            )
        raw = source.read(limit + 1)
        if len(raw) > limit:
            raise RuntimeError("Installer payload manifest is too large.")

    payload = json.loads(raw.decode("utf-8"))
    if (
        not isinstance(payload, dict)
        or type(payload.get("schema")) is not int
        or payload["schema"] != 1
    ):
        raise RuntimeError("Unsupported installer payload manifest schema.")

    expected = payload.get("calamares_version")
    if (
        not isinstance(expected, str)
        or len(expected) > 128
        or re.fullmatch(
            r"[0-9][A-Za-z0-9.+:~_-]*\+corevault[0-9][A-Za-z0-9.+~_-]*",
            expected,
        ) is None
    ):
        raise RuntimeError(
            "Installer payload manifest does not pin a reviewed corevault package."
        )
    return expected


def main():

    if os.geteuid() != 0 or len(sys.argv) != 1:
        raise RuntimeError(
            "This fixed installer launcher requires root and no arguments."
        )

    cmdline = pathlib.Path("/proc/cmdline").read_text().split()

    if (
        "boot=live" not in cmdline
        or "core-vault.install=1" not in cmdline
    ):
        raise RuntimeError(
            "Installer is available only from the dedicated "
            "Live installation boot entry."
        )

    squashfs = pathlib.Path(
        "/run/live/medium/live/filesystem.squashfs"
    )

    if not squashfs.is_file():
        raise RuntimeError(
            "Immutable installation image not found. "
            "Keep the boot USB connected."
        )

    if pathlib.Path(
        "/etc/core-vault/installation.json"
    ).exists():
        raise RuntimeError(
            "Installer launcher is not permitted in an installed system."
        )

    # A read-only squashfs is required; never copy the mutable live overlay.
    mount_info = subprocess.check_output([
        '/usr/bin/findmnt', '--noheadings', '--output', 'FSTYPE,OPTIONS',
        '--target', str(squashfs)], text=True).strip().split()
    if len(mount_info) != 2 or 'ro' not in mount_info[1].split(','):
        raise RuntimeError('The installation medium must be mounted read-only.')

    vault = pwd.getpwnam("vault")

    if os.environ.get("SUDO_UID") != str(vault.pw_uid):
        raise RuntimeError(
            "Installer must be requested by the local vault session."
        )

    display = os.environ.get("DISPLAY", "")

    if (
        not display.startswith(":")
        or not display[1:].replace(".", "").isdigit()
    ):
        raise RuntimeError(
            "Only the local X display is supported."
        )

    auth = pathlib.Path(
        os.environ.get(
            "XAUTHORITY",
            str(
                pathlib.Path(vault.pw_dir)
                / ".Xauthority"
            )
        )
    )

    if (
        auth.is_symlink()
        or not auth.is_file()
        or auth.stat().st_uid != vault.pw_uid
        or auth.stat().st_size > 1048576
    ):
        raise RuntimeError(
            "Local X authorization file is missing "
            "or has the wrong owner."
        )

    run = pathlib.Path(
        "/run/core-vault-installer"
    )

    if run.is_symlink():
        raise RuntimeError("Unsafe installer runtime directory.")

    run.mkdir(
        mode=0o700,
        exist_ok=True
    )

    run.chmod(0o700)
    os.chown(run, 0, 0)

    newauth = run / "Xauthority"

    if newauth.is_symlink():
        raise RuntimeError("Unsafe X authorization copy.")
    shutil.copyfile(auth, newauth)

    newauth.chmod(0o600)

    expected_version = reviewed_calamares_version()
    package = subprocess.run(
        [
            "/usr/bin/dpkg-query",
            "-W",
            "-f=${Status}\n${Version}\n",
            "calamares",
        ],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
        timeout=10,
    )
    fields = package.stdout.splitlines()
    status = fields[0].strip() if fields else "(unavailable)"
    version = fields[1].strip() if len(fields) >= 2 else "(unavailable)"

    if (
        package.returncode != 0
        or len(fields) != 2
        or status != "install ok installed"
        or version != expected_version
    ):
        detail = package.stderr.strip()[-2048:]
        raise RuntimeError(
            "The reviewed Bitcoin Core Vault Calamares package is not installed.\n"
            f"Expected version: {expected_version}\n"
            f"Installed version: {version}\n"
            f"Package status: {status}"
            + (f"\ndpkg-query: {detail}" if detail else "")
        )

    env = {
        "PATH": "/usr/sbin:/usr/bin:/sbin:/bin",
        "HOME": "/root",
        "USER": "root",
        "LOGNAME": "root",
        "DISPLAY": display,
        "XAUTHORITY": str(newauth),
        "LANG": "en_US.UTF-8",
        "LC_ALL": "en_US.UTF-8",
        "LANGUAGE": "en",
        "QT_QPA_PLATFORM": "xcb",
        "QT_QUICK_BACKEND": "software",
        "XDG_RUNTIME_DIR": "/run/core-vault-installer",
    }

    log = run / "installer.log"

    with log.open(
        "a",
        encoding="utf-8"
    ) as stream:

        result = subprocess.run(
            [
                "/usr/bin/calamares",
                "-d",
            ],
            env=env,
            stdout=stream,
            stderr=subprocess.STDOUT,
        )

    if result.returncode != 0:
        detail = ""
        if result.returncode < 0:
            number = -result.returncode
            try:
                name = signal.Signals(number).name
            except ValueError:
                name = "unknown signal"
            detail = f" (terminated by signal {number}: {name})"
        print(
            f"Calamares process return code: {result.returncode}{detail}",
            file=sys.stderr,
        )
        print_log_tail(log)

    return result.returncode


if __name__ == "__main__":

    try:
        sys.exit(main())

    except Exception as exc:
        print(
            "Bitcoin Core Vault installer launcher error:",
            str(exc),
            file=sys.stderr,
        )
        sys.exit(1)
